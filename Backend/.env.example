APP_ENV=development
JWT_SECRET_KEY=replace-with-at-least-32-random-characters
OAUTH_ISSUER=
OAUTH_AUDIENCE=
OAUTH_JWKS_URL=
OAUTH_USER_ID_CLAIM=user_id
OAUTH_REG_ID_CLAIM=reg_id
ALLOW_LOCAL_OAUTH=true
ALLOW_LEGACY_USER_TOKEN=true
ADMIN_EMAIL=admin@example.edu
ADMIN_PASSWORD=replace-with-a-strong-password
ADMIN_TOKEN_EXPIRE_MINUTES=480
REQUIRE_EMAIL_DELIVERY=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true

LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
LLM_TEMPERATURE=0.3
OLLAMA_NUM_CTX=4096
OLLAMA_NUM_PREDICT=256
OLLAMA_TIMEOUT_SECONDS=60

PINECONE_API_KEY=
PINECONE_INDEX_NAME=multilingual-text
PINECONE_DIMENSION=384
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1
RAG_SCORE_THRESHOLD=0.35
MENTAL_HEALTH_ML_THRESHOLD=0.80

REDIS_CACHE_ENABLED=true
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_SIMILARITY_THRESHOLD=0.92

CORS_ORIGINS=http://localhost:5173
DATABASE_ECHO=false
CHAT_MEMORY_BACKEND=json
CHAT_MEMORY_MAX_INTERACTIONS=100
MAX_UPLOAD_BYTES=10485760
MAX_DOCUMENT_PAGES=200
SEED_LOCAL_DATA=true
